#!/bin/bash

### This script is called after the user installs the application.
### Provisions the resident engine API key (127.0.0.1:8080, trim.hermes Strata
### worker) into the app's own data dir so the package user can read it at
### start. Callbacks run as root, so the source json (0700 trim.hermes) is
### readable here. Idempotent; also reused by upgrade_callback.

APPNAME="hermes-si"
KEYFILE="${TRIM_PKGHOME}/data/engine_key"
SRC_JSON="$(ls -1 /vol2/@appdata/trim.hermes/workspace/strata/strata-*.json 2>/dev/null | head -1)"

mkdir -p "${TRIM_PKGHOME}/data" 2>/dev/null

TMPKEY="${KEYFILE}.tmp"
python3 - "${SRC_JSON:-/nonexistent}" > "$TMPKEY" 2>/dev/null <<'PY'
import json, sys
try:
    k = json.load(open(sys.argv[1])).get("api_key", "")
    print(k) if k else sys.exit(1)
except Exception:
    sys.exit(1)
PY

if [ -s "$TMPKEY" ] && grep -q . "$TMPKEY"; then
    mv -f "$TMPKEY" "$KEYFILE"
    chmod 600 "$KEYFILE" 2>/dev/null
    chown "${APPNAME}:${APPNAME}" "$KEYFILE" 2>/dev/null
else
    rm -f "$TMPKEY"
fi

exit 0
