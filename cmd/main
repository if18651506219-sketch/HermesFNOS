#!/bin/bash
# Hermes SI (hermes-agent v0.22.3) fpk lifecycle: native web dashboard behind
# the fnOS unified gateway (unix socket + prefix/path-rewriting proxy).
# The dashboard is the UPSTREAM UI (hermes dashboard --skip-build); no frontend
# modifications. Runtime: bundled python3.14 + packaged venv + packaged source.

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
DASH_PID_FILE="${TRIM_PKGVAR}/dash.pid"
PROXY_PID_FILE="${TRIM_PKGVAR}/proxy.pid"
SOCK_PATH="${TRIM_APPDEST}/hermes-si.sock"
HTTP_PORT_FILE="${TRIM_PKGVAR}/http_port"
APP_HOME="${TRIM_PKGHOME}/data"
HERMES_HOME_DIR="${APP_HOME}/hermes-home"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        return 0
    fi
    return 1
}

pid_of() {
    local f=$1
    if [ -f "$f" ]; then
        head -n 1 "$f" | tr -d '[:space:]'
    fi
}

clean_pidfile() {
    local f=$1
    if [ -f "$f" ]; then
        local p=$(pid_of "$f")
        if ! check_process "$p"; then
            rm -f "$f"
        fi
    fi
}

running() {
    clean_pidfile "${DASH_PID_FILE}"
    clean_pidfile "${PROXY_PID_FILE}"
    [ -f "${DASH_PID_FILE}" ] && [ -f "${PROXY_PID_FILE}" ]
}

pick_port() {
    # default hermes dashboard port is 9119; take that range but dodge any
    # pre-existing listener (e.g. a dev dashboard started manually).
    for p in 9119 9120 9121 9122 9123; do
        if ! ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"; then
            echo "$p"
            return 0
        fi
    done
    echo 9119
}

find_node() {
    # TUI runtime for the in-browser chat tab (hermes_cli/tui_dist/entry.js).
    # Prefer the nodejs fpk when installed, then fnOS' system node.
    if [ -x /var/apps/nodejs_v24/target/bin/node ]; then
        echo /var/apps/nodejs_v24/target/bin/node
        return 0
    fi
    if [ -x /usr/bin/node ]; then
        echo /usr/bin/node
        return 0
    fi
    echo ""
}

seed_config() {
    # First-run: point the agent at the resident local OpenAI-compatible
    # engine on 127.0.0.1:8080 (trim.hermes Strata worker / any llama.cpp-style
    # server). Everything stays user-editable afterwards through Settings.
    #
    # fnOS-port 0.22.7.1: use the SAME nested config shape that verify.py's
    # write_sim_config() has proven in L1/L2/L3. The old flat
    # "model:/provider:/base_url:" seed was never exercised by any tier (L1
    # overwrites config.yaml before start) and disagrees with the upstream
    # provider schema. Also inject the key that install_callback extracted —
    # it used to be written to disk and then never passed to the process.
    [ -f "${HERMES_HOME_DIR}/config.yaml" ] && return 0
    local model="" key="" health
    health=$(curl -sf --max-time 2 http://127.0.0.1:8080/health 2>/dev/null)
    if [ -n "$health" ]; then
        model=$(echo "$health" | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    fi
    [ -n "$model" ] || model="local"
    if [ -s "${APP_HOME}/engine_key" ]; then
        key=$(head -n 1 "${APP_HOME}/engine_key" | tr -d '\r\n')
    fi
    # quote/escape values so a key containing ':' or '#' cannot break YAML
    model=$(echo "$model" | sed 's/\\/\\\\/g; s/"/\\"/g')
    key=$(echo "$key" | sed 's/\\/\\\\/g; s/"/\\"/g')
    cat > "${HERMES_HOME_DIR}/config.yaml" <<EOF
model:
  provider: custom
  default: "${model}"
providers:
  custom:
    base_url: http://127.0.0.1:8080/v1
    api_key: "${key}"
    default_model: "${model}"
    api_mode: chat_completions
EOF
    chmod 600 "${HERMES_HOME_DIR}/config.yaml" 2>/dev/null
    log_msg "seeded config.yaml (model=${model}, key=$([ -n "$key" ] && echo present || echo absent))"
}

seed_persona() {
    # First-run: deploy bundled SOUL.md / AGENTS.md / skills (fnOS knowledge +
    # trim-cli) into HERMES_HOME, same as the official installer seeds prompts.
    # Only files missing on disk are copied — user edits survive upgrades.
    local seed="${TRIM_APPDEST}/seeds"
    [ -d "$seed" ] || return 0
    for f in SOUL.md AGENTS.md; do
        if [ -f "$seed/$f" ] && [ ! -f "${HERMES_HOME_DIR}/$f" ]; then
            cp -f "$seed/$f" "${HERMES_HOME_DIR}/$f"
        fi
    done
    if [ -d "$seed/skills" ] && [ ! -d "${HERMES_HOME_DIR}/skills" ]; then
        cp -r "$seed/skills" "${HERMES_HOME_DIR}/skills" 2>/dev/null || true
    fi
}

systemctl_user() {
    # fnOS-port P0-1/P0-2: drive the upstream systemd-user gateway unit
    # (hermes-gateway-<hash>.service). Fire-and-forget variant: stdout is
    # discarded on purpose (stop/disable/daemon-reload).
    local u
    u=$(id -u)
    [ -S "/run/user/${u}/bus" ] || return 0
    XDG_RUNTIME_DIR="/run/user/${u}" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${u}/bus" \
        systemctl --user "$@" >/dev/null 2>&1 || true
}

systemctl_user_out() {
    # fnOS-port 0.22.7.1: callers parsing stdout MUST use this variant. The
    # quiet wrapper above used to swallow `list-units` / `show`, so the unit
    # enumeration and ExecStart probe always saw an empty string and the
    # stop/disable loop was dead code.
    local u
    u=$(id -u)
    [ -S "/run/user/${u}/bus" ] || return 0
    XDG_RUNTIME_DIR="/run/user/${u}" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${u}/bus" \
        systemctl --user "$@" 2>/dev/null || true
}

reap_gateway() {
    [ "${HERMES_NO_REAP:-0}" = "1" ] && return 0
    # fnOS-port 0.22.5.3 P0-5: single-supervisor. The dashboard auto-spawns and
    # respawns its gateway (unmanaged); if a systemd-user unit coexists, both
    # owners fight over gateway.lock and Restart=always storms (~every 26s the
    # losing attempt exits non-zero, breaking chat connections). Uninstall it.
    for un in $(systemctl_user_out list-units --all --no-legend 'hermes-gateway-*' | awk '{print $1}'); do
        systemctl_user stop "$un"
        systemctl_user disable "$un"
    done
    rm -rf "${HERMES_HOME_DIR}/.config/systemd/user/"hermes-gateway-*.service \
           "${HERMES_HOME_DIR}/.config/systemd/user/"hermes-gateway-*.service.d \
           "${HERMES_HOME_DIR}/.config/systemd/user/default.target.wants/"hermes-gateway-*.service 2>/dev/null
    systemctl_user daemon-reload
    pkill -TERM -f "hermes-si.*gateway run" 2>/dev/null || true
    pkill -TERM -f "hermes-si.*hermes_cli.main gateway" 2>/dev/null || true
    # PPID=1 orphans (crashed dashboard parent) wedge gateway_state.json.
    for p in $(ps -eo pid,ppid,args 2>/dev/null | awk '$2==1 && /hermes-si.*(gateway run|hermes_cli.main gateway)/ {print $1}'); do
        kill -TERM "$p" 2>/dev/null || true
    done
    # fnOS-port 0.22.5.4 P0-9: lock-holder takeover. A live gateway from an
    # external session (debug agent, manual run) can hold gateway.lock with
    # PPID pointing at another app; our respawn would defer to it forever.
    # The lock record carries hermes_home: if it names THIS app's home, the
    # holder belongs to us — terminate it and clear the records.
    LOCKF="${HERMES_HOME_DIR}/gateway.lock"
    if [ -f "$LOCKF" ]; then
        holder=$(sed -n 's/.*"pid": \([0-9]*\).*/\1/p' "$LOCKF" 2>/dev/null)
        hhome=$(sed -n 's/.*"hermes_home": "\([^"]*\)".*/\1/p' "$LOCKF" 2>/dev/null)
        if [ -n "$holder" ] && [ "$hhome" = "${HERMES_HOME_DIR}" ] && kill -0 "$holder" 2>/dev/null; then
            log_msg "reap: taking over gateway.lock held by pid $holder"
            kill -TERM "$holder" 2>/dev/null || true
            sleep 3
            kill -KILL "$holder" 2>/dev/null || true
        fi
        rm -f "$LOCKF" "${HERMES_HOME_DIR}/gateway_state.json" "${HERMES_HOME_DIR}/gateway.pid" 2>/dev/null
        # Root-owned host rendezvous records left by manual `gateway run` under
        # sudo make every app gateway start spam "owned by uid 0" warnings.
        # The parent dirs belong to the app user, so unlink works regardless
        # of file ownership; safe because we just terminated the holder.
        rm -f "${HERMES_HOME_DIR}/.local/state/hermes/gateway-locks/"*.json 2>/dev/null
    fi
}

start_process() {
    if running; then
        return 0
    fi
    log_msg "Starting hermes-si dashboard ..."

    # reap orphans from earlier starts/upgrades: anything still holding our
    # socket/port but absent from our pidfiles would hang the gateway.
    pkill -TERM -f "sock_proxy.py ${SOCK_PATH}" 2>/dev/null || true
    pkill -TERM -f "${TRIM_APPDEST}/venv/bin/python3.14 -m hermes_cli.main dashboard" 2>/dev/null || true
    reap_gateway
    # fnOS-port P0-2: a unit left over from a previous install can point ExecStart
    # at a launcher that reinstall deleted; systemd then 203/EXEC auto-restart
    # storms until the dashboard regenerates it. Drop broken units up front.
    for uf in "${HERMES_HOME_DIR}/.config/systemd/user/"hermes-gateway-*.service; do
        [ -f "$uf" ] || continue
        un=$(basename "$uf")
        ex=$(systemctl_user_out show "$un" -p ExecStart | tr ';' '\n' | grep -m1 -oE 'path=[^ ]+' | cut -d= -f2)
        if [ -z "$ex" ]; then
            ex=$(grep -m1 '^ExecStart=' "$uf" | awk '{print $2}' | tr -d '"')
        fi
        if [ -n "$ex" ] && [ ! -x "$ex" ]; then
            log_msg "stale gateway unit $un (ExecStart missing: $ex) -> removing"
            systemctl_user stop "$un"
            systemctl_user disable "$un"
            rm -rf "${uf}.d" "$uf" "${HERMES_HOME_DIR}/.config/systemd/user/default.target.wants/${un}"
            systemctl_user daemon-reload
        fi
    done
    sleep 1

    mkdir -p "${HERMES_HOME_DIR}" "${APP_HOME}/logs" "$(dirname "${SOCK_PATH}")"

    # fnOS-port 0.22.5.3 P0-6: upstream Feishu group policy defaults to
    # 'allowlist' with an empty FEISHU_ALLOWED_USERS, so a bot added to any
    # group silently ignores every member (drops logged only at DEBUG after
    # the first). Seed an explicit default once the app has Feishu credentials
    # configured; users can still override by editing .env themselves.
    if [ -f "${HERMES_HOME_DIR}/.env" ] && grep -q '^FEISHU_APP_ID=' "${HERMES_HOME_DIR}/.env" \
       && ! grep -q '^FEISHU_GROUP_POLICY=' "${HERMES_HOME_DIR}/.env"; then
        printf 'FEISHU_GROUP_POLICY=open\n' >> "${HERMES_HOME_DIR}/.env"
    fi

    # fnOS-port 0.22.7.1: seed config/persona FIRST. This block used to run
    # before seed_config, so on a fresh install (no config.yaml yet) the NAS
    # gateway defaults were silently skipped until the SECOND restart.
    seed_config
    seed_persona

    # Seed NAS-resident gateway defaults (idempotent): watchdog tolerance for
    # busy NAS hosts + unmanaged_idle_exit_seconds=0 (the desktop default reaps
    # an unmanaged gateway after 600s idle, wrong on a NAS).
    if [ -f "${HERMES_HOME_DIR}/config.yaml" ]; then
        grep -q "^gateway:" "${HERMES_HOME_DIR}/config.yaml" || printf '\ngateway:\n' >> "${HERMES_HOME_DIR}/config.yaml"
        for kv in "loop_watchdog_max_strikes: 8" "unmanaged_idle_exit_seconds: 0"; do
            grep -qE "^[[:space:]]*${kv%%:*}[[:space:]]*:" "${HERMES_HOME_DIR}/config.yaml" || \
                sed -i "/^gateway:$/a\  ${kv}" "${HERMES_HOME_DIR}/config.yaml" 2>/dev/null
        done
    fi

    local port=$(cat "${HTTP_PORT_FILE}" 2>/dev/null)
    if [ -z "${port}" ] || ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"; then
        port=$(pick_port)
        printf "%s" "${port}" > "${HTTP_PORT_FILE}"
    fi

    local node=$(find_node)

    # Upstream-native launch: python3.14 + packaged venv site-packages + the
    # packaged source tree, `hermes dashboard --skip-build` (pre-built web_dist
    # and tui_dist ship inside src/hermes_cli/). Loopback only; the gateway
    # unix socket is the sole way in.
    export HERMES_HOME="${HERMES_HOME_DIR}"
    export HOME="${HERMES_HOME_DIR}"
    export PYTHONPATH="${TRIM_APPDEST}/venv/lib/python3.14/site-packages:${TRIM_APPDEST}/src"
    export PATH="${TRIM_APPDEST}/venv/bin:${PATH}"
    if [ -n "${node}" ]; then
        export HERMES_NODE="${node}"
    fi
    # fnOS-port 0.22.7.1: engine key for the resident 8080 worker, written by
    # install_callback. The old line exported a hard-coded placeholder, so the
    # extracted key never reached the process. seed_config also writes it into
    # config.yaml (the path the dashboard actually reads for custom providers).
    if [ -s "${APP_HOME}/engine_key" ]; then
        export OPENAI_API_KEY="$(head -n 1 "${APP_HOME}/engine_key" | tr -d '\r\n')"
    fi

    ( cd "${TRIM_APPDEST}/src" && \
      exec "${TRIM_APPDEST}/python314/bin/python3.14" -m hermes_cli.main dashboard \
        --skip-build --no-open --host 127.0.0.1 --port "${port}" >> "${LOG_FILE}" 2>&1 ) &
    printf "%s" "$!" > "${DASH_PID_FILE}"

    # wait for the dashboard to bind, then attach the gateway unix socket
    local ready=0
    for i in $(seq 1 40); do
        if ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"; then
            ready=1
            break
        fi
        sleep 1
    done
    if [ "${ready}" != "1" ]; then
        # fnOS-port 0.22.7.1: no more false green. Previously we logged the
        # failure, started the proxy anyway and returned 0, so the app center
        # reported "running" on a dead service.
        log_msg "dashboard did not bind port ${port} in 40s -> start FAILED"
        rm -f "${DASH_PID_FILE}"
        return 1
    fi

    ( exec /usr/bin/python3 \
        "${TRIM_APPDEST}/sock_proxy.py" "${SOCK_PATH}" "${port}" "/app/hermes-si" >> "${LOG_FILE}" 2>&1 ) &
    printf "%s" "$!" > "${PROXY_PID_FILE}"

    # A live proxy process is not proof the app is reachable: wait for the
    # gateway unix socket before declaring success.
    local sock_ready=0
    for i in $(seq 1 20); do
        if [ -S "${SOCK_PATH}" ]; then sock_ready=1; break; fi
        sleep 0.5
    done
    if [ "${sock_ready}" != "1" ]; then
        log_msg "proxy did not create ${SOCK_PATH} -> start FAILED"
        stop_process
        return 1
    fi

    printf "%s" "$$" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping hermes-si ..."
    for f in "${DASH_PID_FILE}" "${PROXY_PID_FILE}"; do
        local p=$(pid_of "$f")
        if check_process "$p"; then
            kill -TERM "${p}" 2>/dev/null
            local count=0
            while check_process "${p}" && [ $count -lt 15 ]; do
                sleep 1
                count=$((count + 1))
            done
            check_process "${p}" && kill -KILL "${p}" 2>/dev/null
        fi
        rm -f "$f"
    done
    # TUI chat tab spawns node children under the dashboard; sweep by our paths
    pkill -TERM -f "${TRIM_APPDEST}/src" 2>/dev/null
    pkill -TERM -f "hermes-si.sock" 2>/dev/null
    # fnOS-port P0-1: also stop the systemd-user gateway unit and any surviving
    # gateway process, otherwise an orphan holds gateway_state.json and the UI
    # shows a permanently fatal/stale gateway after restart.
    reap_gateway
    rm -f "${SOCK_PATH}" "${PID_FILE}"
    return 0
}

status() {
    # fnOS-port 0.22.7.1: pidfiles alone used to report "running" even when
    # the dashboard never bound its port or the proxy never created the socket.
    running || return 1
    [ -S "${SOCK_PATH}" ] || return 1
    local port=$(cat "${HTTP_PORT_FILE}" 2>/dev/null)
    if [ -n "${port}" ]; then
        ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$" || return 1
    fi
    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
