+def _read_guarded(response, n: int) -> bytes:
+    """``response.read1`` with an explicit socket-stall guard.
+
+    urlopen's timeout only bounds the connect/header phase, so a server that
+    dribbles bytes — or a half-closed TLS socket — can park a downloader
+    thread inside ``ssl`` read indefinitely; field reports showed the gateway
+    liveness watchdog firing while pm fetch threads sat exactly there.
+    ``read1`` returns whatever the buffer already holds and the socket
+    timeout bounds every wait, turning a silent wedge into a normal
+    incomplete-read retry.
+    """
+    try:
+        sock = response.fp.raw._sock  # type: ignore[attr-defined]
+    except AttributeError:
+        sock = None
+    if sock is not None:
+        with suppress(Exception):
+            sock.settimeout(_READ_STALL_SECONDS)
+    try:
+        return response.read1(n)
+    except (socket.timeout, TimeoutError) as exc:
+        raise http.client.IncompleteRead(b"", n) from exc
+
