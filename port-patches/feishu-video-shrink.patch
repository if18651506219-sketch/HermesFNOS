+    # fnOS-port patch: Feishu im/v1/files hard-limits uploads at 30MB; beyond that the edge
+    # returns a non-JSON body and the SDK dies with JSONDecodeError ("Expecting value").
+    _FEISHU_FILE_UPLOAD_LIMIT = 30 * 1024 * 1024
+    _FEISHU_SHRINK_VIDEO_EXTS = {".mp4", ".mov", ".mkv", ".webm", ".avi"}
+
+    async def _shrink_media_for_feishu(self, file_path: str) -> Optional[str]:
+        """Re-encode an oversized video to ~26MB via ffmpeg; return temp path or None."""
+        import shutil as _shutil
+        import subprocess
+        if Path(file_path).suffix.lower() not in self._FEISHU_SHRINK_VIDEO_EXTS:
+            return None
+        if not (_shutil.which("ffmpeg") and _shutil.which("ffprobe")):
+            return None
+        out_dir = get_hermes_home() / "cache"
+        out_dir.mkdir(parents=True, exist_ok=True)
+        out_path = str(out_dir / f"feishu_shrunk_{os.getpid()}_{os.path.basename(file_path)}")
+
+        def _encode() -> Optional[str]:
+            probe = subprocess.run(
+                ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", file_path],
+                capture_output=True, text=True, timeout=60)
+            try:
+                duration = float(probe.stdout.strip())
+            except ValueError:
+                return None
+            if duration <= 0:
+                return None
+            audio_kbps = 96
+            v_kbps = max(350, int((26 * 1024 * 1024 * 8) / (1024 * duration)) - audio_kbps - 40)
+            cmd = [
+                "ffmpeg", "-y", "-v", "error", "-i", file_path,
+                "-c:v", "libx264", "-preset", "veryfast",
+                "-b:v", f"{v_kbps}k", "-maxrate", f"{v_kbps * 2}k", "-bufsize", f"{v_kbps * 2}k",
+                "-vf", "scale='min(1280,iw)':-2",
+                "-c:a", "aac", "-b:a", f"{audio_kbps}k",
+                "-movflags", "+faststart", out_path,
+            ]
+            try:
+                subprocess.run(cmd, capture_output=True, timeout=900, check=True)
+            except (subprocess.SubprocessError, OSError):
+                try:
+                    os.unlink(out_path)
+                except OSError:
+                    pass
+                return None
+            try:
+                if os.path.getsize(out_path) > 29 * 1024 * 1024:
+                    os.unlink(out_path)
+                    return None
+            except OSError:
+                return None
+            return out_path
+
+        return await asyncio.to_thread(_encode)
+
